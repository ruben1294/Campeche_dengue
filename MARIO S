TEMPERATURA MAX

# =========================
# 1. DATOS
# =========================
anio <- 2013:2024

temp_max <- c(32.4, 33, 33.6, 33.7, 33.6, 32.9,
              33.6, 33.5, 33.4, 33, 34.2, 34)

casos <- c(1685, 977, 7475, 4109, 588, 194,
           760, 302, 90, 604, 13397, 5996)

df <- data.frame(anio, temp_max, casos)

# =========================
# 2. EXPLORACIÓN
# =========================
summary(df)
str(df)

# =========================
# 3. CORRELACIONES
# =========================

# Pearson
cor_pearson <- cor.test(df$temp_max,
                        df$casos,
                        method = "pearson")

# Spearman
cor_spearman <- cor.test(df$temp_max,
                         df$casos,
                         method = "spearman",
                         exact = FALSE)

# =========================
# 4. RESULTADOS
# =========================
cat("=== CORRELACIÓN DE PEARSON ===\n")
print(cor_pearson)

cat("\n=== CORRELACIÓN DE SPEARMAN ===\n")
print(cor_spearman)
# =========================
# 4. GRÁFICA BÁSICA
# =========================
library(ggplot2)

ggplot(df, aes(x = temp_max, y = casos)) +
  geom_point(size = 3) +
  geom_smooth(method = "lm", se = TRUE) +
  labs(title = "Temperatura máxima vs dengue",
       x = "Temperatura máxima (°C)",
       y = "Casos de dengue") +
  theme_minimal()

# =========================
# 5. REGRESIÓN LINEAL
# =========================
modelo <- lm(casos ~ temp_max, data = df)
summary(modelo)

# =========================
# 7. NORMALIDAD DE RESIDUOS
# =========================
shapiro.test(residuals(modelo))


TEMPERATURA MIN

# =========================
# DATOS
# =========================
# Datos
anio <- 2013:2024
temp_minima <- c(21.1,21.3,21.7,22,21.8,21.2,21.7,22.1,21.7,21.7,22.5,22.7)

casos <- c(1685, 977, 7475, 4109, 588, 194, 760, 302, 90, 604, 13397, 5996)

# Crear data frame
datos <- data.frame(anio, temp_minima, casos)

# =========================
# Correlación
# =========================
cor_temp <- cor.test(datos$casos, datos$temp_minima)
cat("Correlación casos vs temperatura minima:\n")
print(cor_temp)

# =========================
#Regresión lineal simple
# =========================
modelo_temp <- lm(casos ~ temp_minima, data = datos)
cat("\nResumen del modelo de regresión:\n")
summary(modelo_temp)

