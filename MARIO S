TEMPERATURA MINIMA 
# =========================
# 1. DATOS
# =========================
anio <- 2013:2024

temp_med <- c(26.8, 27.2, 27.6, 27.8, 27.7, 27.0,
              27.6, 27.8, 27.5, 27.3, 28.3, 28.3)

casos <- c(1685, 977, 7475, 4109, 588, 194,
           760, 302, 90, 604, 13397, 5996)

df <- data.frame(anio, temp_med, casos)

# =========================
# 2. EXPLORACIÓN
# =========================
summary(df)
str(df)

# =========================
# 3. CORRELACIONES
# =========================
cor_pearson <- cor.test(df$temp_med,
                        df$casos,
                        method = "pearson")

cor_spearman <- cor.test(df$temp_med,
                         df$casos,
                         method = "spearman",
                         exact = FALSE)

# =========================
# 4. RESULTADOS
# =========================
cor_pearson
cor_spearman

# =========================
# 4. GRÁFICA DISPERSIÓN + REGRESIÓN
# =========================
library(ggplot2)

g1 <- ggplot(df, aes(x = temp_med, y = casos)) +
  geom_point(size = 3) +
  geom_smooth(method = "lm", se = TRUE) +
  labs(title = "Temperatura media vs dengue",
       x = "Temperatura media anual (°C)",
       y = "Casos de dengue") +
  theme_minimal()

print(g1)

# =========================
# 5. REGRESIÓN LINEAL
# =========================
modelo <- lm(casos ~ temp_med, data = df)
summary(modelo)

